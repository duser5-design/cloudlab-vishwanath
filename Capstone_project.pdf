   "source": [
    "full_duplicates = df.duplicated().sum()\n",
    "policy_duplicates = df.duplicated(subset=['policy_id']).sum()\n",
    "print(f\"Number of full row duplicates: {full_duplicates}\")\n",
    "print(f\"Number of duplicate policy_ids: {policy_duplicates}\")\n",
    "\n",
    "print(\"Boolean Column Audit\")\n",
    "whitespace_issues = []\n",
    "\n",
    "for col in bool_cols_raw:\n",
    "    if col in df.columns:\n",
    "        uniqueness =df[col].unique()\n",
    "        value_counts = df[col].value_counts(dropna=False).to_dict()\n",
    "        print(f\"\\n{col}:\")\n",
    "        print(value_counts)\n",
    "\n",
    "        if df[col].dtype =='object':\n",
    "            for val in uniqueness:\n",
    "                if isinstance(val, str) and (val.startswith(' ') or val.endswith(' ') or val == '' or val ==' '):\n",
    "                    whitespace_issues.append(col)\n",
    "                    break\n",
    "\n",
    "if whitespace_issues:\n",
    "    print(f\"\\n Columns with whitespace issues: {list(set(whitespace_issues))}\")"
   ]
  },
