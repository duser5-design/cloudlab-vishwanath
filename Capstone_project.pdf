   ],
   "source": [
    "def parse_power(val):\n",
    "    if pd.isna(val):\n",
    "        return pd.Series([np.nan, np.nan])\n",
    "    val = str(val).strip().lower()\n",
    "    match = re.search(r'([\\d\\.]+)\\s*bhp\\s*@\\s*([\\d\\.]+)\\s*rpm', val)\n",
    "    if match:\n",
    "        return pd.Series([float(match.group(1)), float(match.group(2))])\n",
    "    return pd.Series([np.nan, np.nan])\n",
    "if 'max_power' in df_clean.columns:\n",
    "    print(\"BEFORE max_power parsing:\")\n",
    "    display(df_clean[['max_power']].head(3))\n",
    "    df_clean[['power_bhp', 'power_rpm']] = df_clean['max_power'].apply(parse_power)\n",
    "    df_clean.drop('max_power', axis=1, inplace=True)\n",
    "    print(\"\\nAFTER max_power parsing:\")\n",
    "    display(df_clean[['power_bhp', 'power_rpm']].head(3))"
   ]
  },
