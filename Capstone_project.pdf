    "axes[1].plot(airbag_rate.index, airbag_rate.values, marker='s', color='#8e44ad', linewidth=2)\n",
    "axes[1].set_title('Claim Rate vs Number of Airbags')\n",
    "axes[1].set_xlabel('Number of Airbags')\n",
    "axes[1].set_ylabel('Claim Rate (%)')\n",
