    "\n",
    "sns.kdeplot(data=df_clean[df_clean['is_claim'] == 0]['age_of_car'], color=COLORS['no_claim'], label='No Claim', fill=True, ax=axes[2])\n",
    "sns.kdeplot(data=df_clean[df_clean['is_claim'] == 1]['age_of_car'], color=COLORS['claim'], label='Claim', fill=True, ax=axes[2])\n",
    "axes[2].set_title('KDE Plot of Car Age by Claim', fontsize=12)\n",
    "axes[2].legend()\n",
    "plt.suptitle('Age of Car vs Is Claim', fontsize=16, fontweight='bold', y=1.05)\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "61d5e37f-617b-4915-aeb6-583eaff04558",
