   ],
   "source": [
    "def parse_torque(val):\n",
    "    if pd.isna(val):\n",
    "        return pd.Series([np.nan, np.nan])\n",
    "    val = str(val).strip().lower()\n",
    "    match = re.search(r'([\\d\\.]+)\\s*nm\\s*@\\s*([\\d\\.]+)\\s*rpm', val)\n",
    "    if match:\n",
    "        return pd.Series([float(match.group(1)), float(match.group(2))])\n",
    "    return pd.Series([np.nan, np.nan])\n",
    "if 'max_torque' in df_clean.columns:\n",
    "    print(\"\\nBEFORE max_torque parsing:\")\n",
    "    display(df_clean[['max_torque']].head(3))\n",
    "    df_clean[['torque_nm', 'torque_rpm']] = df_clean['max_torque'].apply(parse_torque)\n",
    "    df_clean.drop('max_torque', axis=1, inplace=True)\n",
    "    print(\"\\nAFTER max_torque parsing:\")\n",
    "    display(df_clean[['torque_nm', 'torque_rpm']].head(3))"
   ]
  },
