   "source": [
    "from matplotlib.colors import ListedColormap\n",
    "import matplotlib.patches as mpatches\n",
    "\n",
    "COLOR = {\n",
    "    'claim'   : 'red',   \n",
    "    'missing' : '#DA291C',   \n",
    "    'present' : '#90EE90',   \n",
    "    'title'   : '#282728',   \n",
    "}\n",
    "missing_data = df.isnull().sum().to_frame(name='Missing Count')\n",
    "missing_data['Missing %'] = (missing_data['Missing Count'] / len(df)) * 100\n",
    "missing_data['Data Type'] = df.dtypes\n",
    "missing_data = (missing_data[missing_data['Missing Count'] > 0]\n",
    "                .sort_values(by='Missing %', ascending=False))\n",
    "if len(missing_data) > 0:\n",
    "    display(\n",
    "        missing_data.style\n",
    "        .background_gradient(cmap='Reds', subset=['Missing %'])\n",
    "        .format({'Missing %': '{:.2f}%'})\n",
    "    )\n",
    "else:\n",
    "    print(\"No missing values found in the dataset!\")\n",
    "\n",
    "cols_with_missing  = missing_data.index.tolist()\n",
    "rows_with_missing  = df[df[cols_with_missing].isnull().any(axis=1)][cols_with_missing]\n",
    "rows_with_missing  = rows_with_missing.loc[\n",
    "    rows_with_missing.isnull().sum(axis=1).sort_values(ascending=False).index\n",
    "]\n",
    "total_missing_rows  = len(rows_with_missing)\n",
    "total_missing_cells = int(missing_data['Missing Count'].sum())\n",
    "cmap_custom = ListedColormap([COLOR['present'], COLOR['missing']])\n",
    "fig_height = max(8, total_missing_rows * 0.22)\n",
    "fig_width  = max(14, len(cols_with_missing) * 0.75)\n",
    "fig, ax = plt.subplots(figsize=(fig_width, fig_height))\n",
    "sns.heatmap(\n",
    "    rows_with_missing.isnull(),\n",
    "    ax=ax,\n",
    "    yticklabels=False,\n",
    "    xticklabels=True,\n",
    "    cbar=False,              \n",
    "    cmap=cmap_custom,\n",
    "    linewidths=0.3,\n",
    "    linecolor='white'\n",
    ")\n",
    "patch_missing = mpatches.Patch(color=COLOR['missing'],  label='Missing value')\n",
    "patch_present = mpatches.Patch(color=COLOR['present'],  label='Present value')\n",
    "ax.legend(handles=[patch_missing, patch_present],\n",
    "          loc='upper right', fontsize=9, framealpha=0.9)\n",
    "ax.set_title(\n",
    "    f'Heatmap of Missing Values  |  {total_missing_rows} affected rows  |  '\n",
    "    f'{total_missing_cells} total missing cells',\n",
    "    pad=14, fontsize=12, fontweight='bold', color=COLOR['title']\n",
    ")\n",
    "ax.set_xlabel('Features', fontsize=10)\n",
    "ax.set_ylabel(f'Rows with missing values (n={total_missing_rows})', fontsize=10)\n",
    "plt.xticks(rotation=45, ha='right', fontsize=9)\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "\n",
    "if len(missing_data) > 0:\n",
    "    fig, ax = plt.subplots(figsize=(10, max(6, len(missing_data) * 0.5)))\n",
    "    bars = ax.barh(\n",
    "        missing_data.index,\n",
    "        missing_data['Missing %'],\n",
    "        color=COLOR['claim'],\n",
    "        edgecolor='white',\n",
    "        height=0.6\n",
    "    )\n",
    "    for bar, (_, row) in zip(bars, missing_data.iterrows()):\n",
    "        ax.text(\n",
    "            bar.get_width() + 0.0005,\n",
    "            bar.get_y() + bar.get_height() / 2,\n",
    "            f\"{int(row['Missing Count'])} ({row['Missing %']:.3f}%)\",\n",
    "            va='center', fontsize=8.5, color=COLOR['title']\n",
    "        )\n",
    "    ax.set_title('Percentage of Missing Values per Feature',\n",
    "                 pad=16, fontsize=13, fontweight='bold', color=COLOR['title'])\n",
    "    ax.set_xlabel('Missing Percentage (%)', fontsize=10)\n",
    "    ax.set_ylabel('Features', fontsize=10)\n",
    "    ax.invert_yaxis()\n",
    "    ax.spines[['top', 'right']].set_visible(False)\n",
    "    plt.tight_layout()\n",
    "    plt.show()\n"
   ]
  },
