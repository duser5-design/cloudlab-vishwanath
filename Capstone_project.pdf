     "name": "stdout",
     "output_type": "stream",
     "text": [
      "No typos found or already corrected.\n"
     ]
    }
   ],
   "source": [
    "expected_names = {\n",
    "    'ebgine_type': 'engine_type',\n",
    "    'is_adjustable_steer' : 'is_adjustable_steering',\n",
    "    'is_power_door_locks': 'is_power_door_locks',\n",
    "    'is_driver_seat_height_ajustable': 'is_driver_seat_height_adjustable'\n",
    "}\n",
    "mismatches = {}\n",
    "for current_name, expected_name in expected_names.items():\n",
    "    if current_name in df.columns and current_name != expected_name:\n",
    "        mismatches[current_name] = expected_name\n",
    "\n",
    "if mismatches:\n",
    "    print(\"Found column name typo. please check it again:\")\n",
    "    for bad,good in mismatches.items():\n",
    "        print(f\"'{bad}' should be '{good}'\")\n",
    "else:\n",
    "    print(\"No typos found or already corrected.\")"
   ]
  },
