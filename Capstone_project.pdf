   "source": [
    "df = pd.merge(df_policy,df_car, on='policy_id', how='outer')\n",
    "df = pd.merge(df,df_claim, on='policy_id', how='outer')\n",
    "print(f\"Master Dataframe Shape:{df.shape}\\n\")\n",
    "policy_ids_policy = set(df_policy['policy_id'])\n",
    "policy_ids_car = set(df_car['policy_id'])\n",
    "policy_ids_claim = set(df_claim['policy_id'])\n",
    "only_in_policy = policy_ids_policy - (policy_ids_car | policy_ids_claim)\n",
    "only_in_car = policy_ids_car - (policy_ids_policy | policy_ids_claim)\n",
    "only_in_claim = policy_ids_claim - (policy_ids_policy | policy_ids_car)\n",
    "missing_in_some = df[df.isnull().any(axis=1)]['policy_id'].tolist()\n",
    "\n",
    "print(f\"Total records with missing mappings (due to order join): {len(missing_in_some)}\")\n",
    "print(f\"Policy ID's unique to Policy Features: {len(only_in_policy)}\")\n",
    "print(f\"Policy ID's unique to Car Features: {len(only_in_car)}\")\n",
    "print(f\"Policy ID's unique to Insurance Claim: {len(only_in_claim)}\")\n",
    "display(df.head())"
   ]
  },
