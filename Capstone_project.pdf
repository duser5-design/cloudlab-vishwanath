    "num_cols_to_plot = df.select_dtypes(include=['int64', 'float64']).columns\n",
    "num_cols_to_plot = [c for c in num_cols_to_plot if c not in ['policy_id', 'is_claim']]\n",
    "if num_cols_to_plot:\n",
    "    n_cols = 3\n",
    "    n_rows = (len(num_cols_to_plot) + n_cols -1)\n",
    "    fig, axes = plt.subplots(n_rows,n_cols, figsize=(15, 4* n_rows))\n",
    "    axes = axes.flatten()\n",
    "    for i, col in enumerate(num_cols_to_plot):\n",
    "        sns.boxplot(x=df[col], ax=axes[i], color='lightpink')\n",
    "        axes[i].set_title(f'Boxplot of {col}')\n",
    "        axes[i].set_xlabel('')\n",
    "        \n",
    "    for j in range(i + 1, len(axes)):\n",
    "        fig.delaxes(axes[j])\n",
    "\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
